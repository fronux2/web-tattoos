  tradicional:
    '<path d="M3 16c3-6 6-9 9-9s6 3 9 9c-3-2-6-3-9-3s-6 1-9 3z"/><circle cx="8" cy="13.5" r="0.6" fill="currentColor" stroke="none"/>',
