---
import MainLayout from '../layouts/MainLayout.astro';
import { Image } from 'astro:assets';
import artistPhoto from '../assets/images/artist/foto-perfil.png';

const styles = ['Blackwork', 'Realismo', 'Floral', 'Tradicional'];
---

<MainLayout>
  <section class="py-16">
    <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-brass-bright mb-3 text-center">El artista</p>
    <h2 class="text-3xl md:text-4xl font-semibold mb-12 text-center">Sobre mí</h2>

    <div class="flex flex-col md:flex-row gap-10 items-start">
      <div class="md:w-1/3 flex-none">
        <Image
          src={artistPhoto}
          alt="Foto del tatuador"
          width={400}
          height={500}
          class="rounded-[2px] border border-hairline-strong w-full"
          quality={80}
        />
      </div>

      <div class="md:w-2/3 space-y-6">
        <h3 class="text-2xl font-semibold font-display">Marcos, artista del tatuaje</h3>
        <p class="text-text-secondary leading-relaxed">
          Con más de 8 años de experiencia en el mundo del tatuaje, me especializo en estilos <span class="text-brass-bright">realismo negro/gris</span> y <span class="text-brass-bright">diseños florales</span>. Cada pieza que creo es un diálogo único con el cliente.
        </p>
        <p class="text-text-secondary leading-relaxed">
          Mi enfoque combina técnica tradicional con influencias modernas, garantizando resultados que perduran en el tiempo tanto en calidad como en significado.
        </p>

        <div class="pt-4">
          <h4 class="font-mono text-[11px] uppercase tracking-[0.14em] text-text-muted mb-3">Estilos que domino</h4>
          <ul class="grid grid-cols-2 gap-x-4 gap-y-2 text-sm">
            {styles.map((style) => (
              <li class="flex items-center text-text-secondary">
                <span class="w-1.5 h-1.5 bg-brass rounded-full mr-2.5"></span> {style}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <div class="mt-14 max-w-3xl bg-ink-surface p-8 rounded-[2px] border-l-2 border-brass">
      <h4 class="font-mono text-[11px] uppercase tracking-[0.14em] text-brass-bright mb-4">Mi filosofía</h4>
      <p class="italic text-text-primary text-lg font-display leading-relaxed">
        "El tatuaje no es solo adornar la piel, es capturar historias en un lenguaje de tinta y dolor transformado en belleza."
      </p>
    </div>
  </section>
</MainLayout>
