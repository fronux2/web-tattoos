---
import MainLayout from '../layouts/MainLayout.astro';
import { Image } from 'astro:assets';
import Icon from '../components/Icon.astro';
import FlashTag from '../components/FlashTag.astro';
import artistPhoto from '../../src/assets/images/tattoos/cara1.png';
import tattoo1 from '../../src/assets/images/tattoos/cara1.png';
import tattoo2 from '../../src/assets/images/tattoos/flor4.png';
import tattoo3 from '../../src/assets/images/tattoos/drake.png';


const featuredTattoos = [
  { image: tattoo1, style: "Blackwork", alt: "Retrato en blanco y negro" },
  { image: tattoo2, style: "Floral", alt: "Diseño floral colorido" },
  { image: tattoo3, style: "Tradicional", alt: "Dragón estilo tradicional" }
];

const specialties = [
  { icon: 'blackwork' as const, title: 'Blackwork', desc: 'Tatuajes en negro puro con alto contraste y detalles precisos' },
  { icon: 'floral' as const, title: 'Floral', desc: 'Diseños botánicos realistas o con toques de acuarela' },
  { icon: 'tradicional' as const, title: 'Tradicional', desc: 'Estilo clásico con líneas gruesas y colores vibrantes' },
  { icon: 'realismo' as const, title: 'Realismo', desc: 'Retratos y diseños que capturan cada detalle con precisión' },
];

const process = [
  { title: 'Consulta inicial', desc: 'Conversamos sobre tu idea, estilo preferido, ubicación y tamaño. Te asesoro sobre lo que funciona mejor.' },
  { title: 'Diseño personalizado', desc: 'Creo un boceto exclusivo basado en nuestra conversación. Realizamos ajustes hasta que sea perfecto.' },
  { title: 'Sesión de tatuaje', desc: 'Con materiales esterilizados y de primera calidad, transformamos el diseño en una obra de arte en tu piel.' },
];

const services = [
  { title: "Tatuajes Personalizados", desc: "Diseños únicos creados especialmente para ti", icon: 'needle' as const },
  { title: "Cover-ups", desc: "Transformamos tatuajes antiguos en nuevas obras de arte", icon: 'coverup' as const },
  { title: "Piercings", desc: "Profesionales con materiales de primera calidad", icon: 'sparkle' as const },
  { title: "Asesoramiento", desc: "Te guiamos en tu primera experiencia de tatuaje", icon: 'chat' as const },
];
---

<MainLayout>
  <!-- Hero -->
  <section class="relative py-24 md:py-32 overflow-hidden -mx-4 sm:-mx-8 lg:-mx-16 px-4 sm:px-8 lg:px-16">
    <div class="absolute inset-0 bg-gradient-to-r from-ink via-ink/85 to-ink/40 z-10"></div>
    <Image
      format="webp"
      src={artistPhoto}
      alt="Artista trabajando"
      width={1600}
      height={900}
      loading="eager"
      priority
      class="absolute inset-0 w-full h-full object-cover"
      quality={75}
      decoding="async"
    />

    <div class="container mx-auto relative z-20">
      <div class="max-w-2xl">
        <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-brass-bright mb-5">Estudio de tatuajes — Buenos Aires</p>
        <h1 class="text-4xl md:text-6xl font-semibold mb-6 text-text-primary leading-[1.05]">
          Arte que perdura en la <span class="text-brass">piel</span>
        </h1>
        <p class="text-lg text-text-secondary mb-9 max-w-md">
          Tatuajes personalizados con pasión, técnica y estilo único
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/gallery" class="bg-brass hover:bg-brass-bright text-paper-ink px-7 py-3.5 rounded-[3px] font-medium transition-colors">
            Ver galería
          </a>
          <a href="/contact" class="border border-hairline-strong text-text-primary hover:bg-ink-elevated px-7 py-3.5 rounded-[3px] font-medium transition-colors">
            Reservar cita
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Especialidades -->
  <section class="py-20">
    <div class="container mx-auto">
      <div class="mb-14 max-w-xl">
        <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-brass-bright mb-3">Especialidades</p>
        <h2 class="text-3xl md:text-4xl font-semibold">Estilos que domino</h2>
        <p class="text-text-secondary mt-3">Cada estilo tiene su lenguaje, y yo hablo varios con fluidez</p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-px bg-hairline rounded-[3px] overflow-hidden">
        {specialties.map((s) => (
          <div class="bg-ink-surface p-7 hover:bg-ink-elevated transition-colors">
            <Icon name={s.icon} class="w-8 h-8 text-brass mb-5" />
            <h3 class="text-lg font-semibold mb-2 font-display">{s.title}</h3>
            <p class="text-text-secondary text-sm leading-relaxed">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Trabajos destacados -->
  <section class="py-20 border-t border-hairline">
    <div class="container mx-auto">
      <div class="mb-14 max-w-xl">
        <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-brass-bright mb-3">Selección</p>
        <h2 class="text-3xl md:text-4xl font-semibold">Trabajos destacados</h2>
        <p class="text-text-secondary mt-3">Una selección de mis piezas favoritas</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {featuredTattoos.map((tattoo) => (
          <figure class="group relative overflow-hidden rounded-[2px] border border-hairline">
            <Image
              format="webp"
              src={tattoo.image}
              alt={tattoo.alt}
              width={600}
              height={800}
              class="w-full h-96 object-cover group-hover:scale-[1.03] transition-transform duration-500"
              loading="lazy"
              quality={80}
            />
            <FlashTag label={tattoo.style} class="absolute -top-1.5 -right-2" />
            <figcaption class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-ink/90 to-transparent p-5 pt-10">
              <p class="text-text-primary text-sm">{tattoo.alt}</p>
            </figcaption>
          </figure>
        ))}
      </div>

      <div class="text-center mt-14">
        <a href="/gallery" class="inline-flex items-center gap-2 px-6 py-3 border border-hairline-strong text-brass-bright hover:bg-ink-elevated rounded-[3px] transition-colors">
          Ver galería completa
          <Icon name="arrow" class="w-4 h-4" />
        </a>
      </div>
    </div>
  </section>

  <!-- Proceso -->
  <section class="py-20 border-t border-hairline">
    <div class="container mx-auto">
      <div class="mb-14 max-w-xl">
        <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-brass-bright mb-3">Cómo trabajo</p>
        <h2 class="text-3xl md:text-4xl font-semibold">Mi proceso</h2>
        <p class="text-text-secondary mt-3">Así trabajo para crear tu tatuaje perfecto</p>
      </div>

      <div class="max-w-3xl">
        {process.map((step, i) => (
          <div class="flex gap-6 pb-10 last:pb-0">
            <div class="flex flex-col items-center">
              <span class="flex-none w-11 h-11 rounded-full border border-hairline-strong flex items-center justify-center font-mono text-sm text-brass-bright">
                {String(i + 1).padStart(2, '0')}
              </span>
              {i < process.length - 1 && <span class="w-px flex-1 bg-hairline mt-2"></span>}
            </div>
            <div class="pt-1.5">
              <h3 class="text-xl font-semibold mb-2 font-display">{step.title}</h3>
              <p class="text-text-secondary leading-relaxed">{step.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Servicios -->
  <section class="py-20 border-t border-hairline">
    <div class="container mx-auto">
      <div class="mb-14 max-w-xl">
        <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-brass-bright mb-3">Servicios</p>
        <h2 class="text-3xl md:text-4xl font-semibold">Mis servicios</h2>
        <p class="text-text-secondary mt-3">Más que tatuajes, experiencias transformadoras</p>
      </div>

      <div class="grid md:grid-cols-2 gap-px bg-hairline rounded-[3px] overflow-hidden max-w-4xl">
        {services.map((service) => (
          <div class="flex items-start gap-5 p-7 bg-ink-surface hover:bg-ink-elevated transition-colors">
            <Icon name={service.icon} class="w-6 h-6 text-brass flex-none mt-1" />
            <div>
              <h3 class="text-lg font-semibold mb-1.5 font-display">{service.title}</h3>
              <p class="text-text-secondary text-sm leading-relaxed">{service.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA final -->
  <section class="py-24 border-t border-hairline bg-ink-surface -mx-4 sm:-mx-8 lg:-mx-16 px-4 sm:px-8 lg:px-16">
    <div class="container mx-auto text-center">
      <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-brass-bright mb-4">Próximo paso</p>
      <h2 class="text-3xl md:text-4xl font-semibold mb-5 max-w-2xl mx-auto">¿Listo para transformar tu piel en arte?</h2>
      <p class="text-lg text-text-secondary mb-9 max-w-xl mx-auto">Agenda una consulta gratuita para hablar sobre tu próximo tatuaje</p>
      <a href="/contact" class="inline-block bg-brass hover:bg-brass-bright text-paper-ink font-medium py-4 px-12 rounded-[3px] transition-colors">
        Contactar ahora
      </a>
    </div>
  </section>
</MainLayout>
